# Copo Certo — variáveis de ambiente do frontend (Vite)
# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API).
#
# Use SOMENTE a chave pública "anon". NUNCA coloque a chave service_role aqui:
# tudo que começa com VITE_ é embutido no JavaScript enviado ao navegador.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
